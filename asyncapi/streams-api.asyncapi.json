          },
          "slLimitPrice": {
            "$ref": "#/components/schemas/Decimal"
          },
          "tpPrice": {
            "$ref": "#/components/schemas/Decimal"
          },
          "tpPriceType": {
            "type": "string",
            "enum": [
              "ABSOLUTE",
              "OFFSET",
              "TRAILING_STOP_OFFSET"
            ]
          },
          "trStopOffset": {
            "$ref": "#/components/schemas/Decimal"
          },
          "positionId": {
            "$ref": "#/components/schemas/Id"
          },
          "isOpen": {
            "type": "boolean"
          },
          "createdDateTime": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "lastUpdate": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "expireDateTime": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "brandId": {
            "$ref": "#/components/schemas/BrandId"
          },
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "accountId": {
            "$ref": "#/components/schemas/AccountId"
          }
        }
      },
      "Property": {
        "type": "object",
        "required": [
          "type",
          "name",
          "brandId",
          "userId",
          "accountId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "Property"
          },
          "name": {
            "type": "string",
            "enum": [
              "SyncEnd",
              "Disconnected"
            ],
            "description": "`SyncEnd`: snapshot complete, live updates follow.\n`Disconnected`: this account's stream ended. Expected after your own UNSUBSCRIBE;\notherwise subscribe it again (with a fresh token if the old one has expired).\n"
          },
          "brandId": {
            "$ref": "#/components/schemas/BrandId"
          },
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "accountId": {
            "$ref": "#/components/schemas/AccountId"
          }
        }
      },
      "AccountsTokensRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "server"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "server": {
            "type": "string",
            "description": "The brand (server) the user logs in to."
          }
        }
      },
      "AccountsTokensResponse": {
        "type": "object",
        "required": [
