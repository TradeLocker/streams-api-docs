      "title": "Production (direct)",
      "summary": "Same production service, reached without an HTTP proxy in front.",
      "description": "Socket.IO URL `https://connect.tradelocker.com/streams-api` with path `/streams-api/socket.io`.\nSame accounts, keys and behaviour as `production`.\n",
      "security": [
        {
          "$ref": "#/components/securitySchemes/developerApiKey"
        }
      ],
      "tags": [
        {
          "name": "env:production"
        }
      ]
    },
    "development": {
