            "type": "string",
            "const": "ClosePosition"
          },
          "positionId": {
            "$ref": "#/components/schemas/Id"
          },
          "closePrice": {
            "$ref": "#/components/schemas/Decimal"
          },
          "closeDateTime": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "brandId": {
            "$ref": "#/components/schemas/BrandId"
          },
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "accountId": {
            "$ref": "#/components/schemas/AccountId"
          }
        }
      },
      "OpenOrder": {
        "type": "object",
        "required": [
          "type",
          "orderId",
          "instrument",
          "amount",
          "lotSize",
          "filledAmount",
          "averageFilledPrice",
          "isOpen",
          "brandId",
          "userId",
          "accountId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "OpenOrder"
          },
          "orderId": {
            "$ref": "#/components/schemas/Id"
          },
          "instrument": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Decimal"
          },
          "lotSize": {
            "$ref": "#/components/schemas/Decimal"
          },
          "side": {
            "$ref": "#/components/schemas/Side"
          },
          "price": {
            "$ref": "#/components/schemas/Decimal"
          },
          "status": {
            "type": "string",
            "enum": [
              "STATUS_NONE",
              "STATUS_PENDING_NEW",
              "STATUS_PENDING_EXECUTION",
              "STATUS_PENDING_CANCEL",
              "STATUS_PENDING_REPLACE",
              "STATUS_PENDING_REPLACE_NOT_ACTIVE",
              "STATUS_NEW",
              "STATUS_ACCEPTED",
              "STATUS_REPLACED",
              "STATUS_PART_FILLED",
              "STATUS_FILLED",
              "STATUS_CANCELED",
              "STATUS_REFUSED",
              "STATUS_RESTATED",
              "EXEC_TYPE_ACTIVATED",
              "STATUS_WAITING_MARKET",
              "STATUS_OFF_MARKET",
              "STATUS_UNPLACED",
              "STATUS_REMOVED",
              "STATUS_MODIFY_TRADING_MODE"
            ]
          },
          "orderType": {
            "type": "string",
            "enum": [
              "MANUAL",
              "MARKET",
              "STOP",
              "LIMIT",
              "STOP_LIMIT",
              "TRAILING_STOP"
            ]
          },
          "tif": {
            "type": "string",
            "description": "Time in force.",
            "enum": [
              "DAY",
              "GTC",
              "IOC",
              "GTD",
              "FOK",
              "MOO",
              "MOC",
              "GTS"
            ]
          },
          "filledAmount": {
            "$ref": "#/components/schemas/Decimal"
          },
          "averageFilledPrice": {
            "$ref": "#/components/schemas/Decimal"
          },
          "stopPrice": {
            "$ref": "#/components/schemas/Decimal"
          },
          "slPrice": {
            "$ref": "#/components/schemas/Decimal"
          },
          "slPriceType": {
            "type": "string",
