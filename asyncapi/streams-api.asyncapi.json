  },
  "channels": {
    "connection": {
      "address": "connection",
      "title": "connection",
      "summary": "Handshake result and socket-level status.",
      "description": "Socket.IO event `connection`, sent by the server:\n\n- right after the handshake: `{\"status\":\"ok\",\"code\":\"connected\"}` when the\n  `developer-api-key` is accepted. Subscribe only after this.\n- when the handshake is rejected: `status: error` with `unauthorized.streams.invalidApiKey`,\n  `unauthorized.streams.developer.notFound`, `conflict` or `unknown`. The server then closes\n  the socket. Do not reconnect in a tight loop on these codes.\n- when the service shuts down: `{\"status\":\"ok\",\"code\":\"disconnected\"}`. All subscriptions on\n  the socket have ended; reconnect and subscribe again.\n",
      "servers": [
        {
          "$ref": "#/servers/production"
        },
        {
          "$ref": "#/servers/production-direct"
        },
        {
          "$ref": "#/servers/development"
        }
      ],
      "messages": {
        "ConnectionStatus": {
          "$ref": "#/components/messages/ConnectionStatus"
        }
      }
    },
    "subscriptions": {
      "address": "subscriptions",
      "title": "subscriptions",
      "summary": "Subscribe and unsubscribe accounts on this socket.",
      "description": "Socket.IO event `subscriptions`, sent by the client **with an acknowledgement callback**.\nThe acknowledgement carries the result (see `SubscriptionAck`). Without a callback you get no\nresult at all.\n",
      "servers": [
        {
          "$ref": "#/servers/production"
        },
        {
          "$ref": "#/servers/production-direct"
        },
        {
          "$ref": "#/servers/development"
        }
      ],
      "messages": {
        "Subscribe": {
          "$ref": "#/components/messages/Subscribe"
        },
        "Unsubscribe": {
          "$ref": "#/components/messages/Unsubscribe"
        }
      }
    },
    "subscriptionsAck": {
      "address": null,
      "title": "subscriptions acknowledgement",
      "summary": "Socket.IO acknowledgement of a `subscriptions` event.",
      "servers": [
        {
          "$ref": "#/servers/production"
        },
        {
          "$ref": "#/servers/production-direct"
        },
        {
          "$ref": "#/servers/development"
        }
      ],
      "messages": {
        "SubscriptionAck": {
          "$ref": "#/components/messages/SubscriptionAck"
        }
      }
    },
    "stream": {
      "address": "stream",
      "title": "stream",
      "summary": "Snapshot and live updates for every subscribed account.",
      "description": "Socket.IO event `stream`, sent by the server. One event carries one message; the `type` field\nsays which. Messages of all accounts on the socket share this event: route them by\n`brandId` + `accountId`.\n\nPer account, after a successful SUBSCRIBE:\n1. snapshot: `AccountStatus`, then `Position` and `OpenOrder` messages for what is open now;\n2. `Property` with `name: SyncEnd`;\n3. live updates, in the order the trading engine produced them.\n\n`SyncEnd` is sent before the SUBSCRIBE acknowledgement.\n",
      "servers": [
        {
          "$ref": "#/servers/production"
        },
        {
          "$ref": "#/servers/production-direct"
        },
        {
          "$ref": "#/servers/development"
        }
      ],
      "messages": {
        "AccountStatus": {
          "$ref": "#/components/messages/AccountStatus"
        },
        "Position": {
          "$ref": "#/components/messages/Position"
        },
        "ClosePosition": {
          "$ref": "#/components/messages/ClosePosition"
        },
        "OpenOrder": {
          "$ref": "#/components/messages/OpenOrder"
        },
        "Property": {
          "$ref": "#/components/messages/Property"
        }
      }
    },
    "accountsTokens": {
      "address": "/auth/jwt/accounts/tokens",
      "title": "POST /auth/jwt/accounts/tokens",
      "summary": "HTTP endpoint that returns a Streams API token for each of the user's accounts.",
      "description": "`POST https://live.tradelocker.com/backend-api/auth/jwt/accounts/tokens` for live accounts,\n`https://demo.tradelocker.com/backend-api/...` for demo accounts. Plain HTTPS with a JSON body,\nnot Socket.IO. Do not send `developer-api-key` here.\n\nThe response has no `brandId`. Read the brand and account from the token's `brand` and `aid`\nclaims (decode the JWT payload; you do not need to verify it, the Streams API does).\n",
      "servers": [
        {
          "$ref": "#/servers/auth-live"
        },
        {
          "$ref": "#/servers/auth-demo"
        },
        {
          "$ref": "#/servers/auth-staging"
        }
      ],
      "messages": {
        "AccountsTokensRequest": {
          "$ref": "#/components/messages/AccountsTokensRequest"
        },
        "AccountsTokensResponse": {
          "$ref": "#/components/messages/AccountsTokensResponse"
        }
      },
      "bindings": {
        "http": {
          "bindingVersion": "0.3.0"
        }
      }
    }
  },
  "operations": {
    "receiveConnectionStatus": {
      "action": "receive",
      "title": "Receive connection status",
      "channel": {
        "$ref": "#/channels/connection"
      },
      "tags": [
        {
          "name": "streams"
        }
      ]
    },
    "subscribe": {
      "action": "send",
      "title": "Subscribe or unsubscribe an account",
      "summary": "Emit `subscriptions` with an acknowledgement callback.",
      "description": "**SUBSCRIBE** takes exactly `action` and `token`; any other key is rejected with\n`validationError - unrecognized_keys`. The brand, account and environment come from the token.\n\n**UNSUBSCRIBE** takes exactly `action`, `brandId` and `accountId`. Both must match the\nsubscription exactly: use the token's `brand` claim (uppercase) and an `accountId` of the form\n`L#<number>` or `D#<number>`.\n\nA SUBSCRIBE for an account already subscribed or still connecting on this socket is answered\nwith `alreadyConnectedError` and changes nothing. Subscribing the same account on two sockets\ngives two independent streams.\n",
      "channel": {
        "$ref": "#/channels/subscriptions"
      },
      "messages": [
        {
          "$ref": "#/channels/subscriptions/messages/Subscribe"
        },
        {
          "$ref": "#/channels/subscriptions/messages/Unsubscribe"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/subscriptionsAck"
        },
        "messages": [
          {
            "$ref": "#/channels/subscriptionsAck/messages/SubscriptionAck"
          }
        ]
      },
      "tags": [
        {
          "name": "streams"
        }
      ]
    },
    "receiveStream": {
      "action": "receive",
      "title": "Receive account updates",
      "channel": {
        "$ref": "#/channels/stream"
      },
      "tags": [
        {
          "name": "streams"
        }
      ]
    },
    "getAccountsTokens": {
      "action": "send",
      "title": "Get account tokens",
      "summary": "Exchange the user's credentials for one Streams API token per account.",
      "channel": {
        "$ref": "#/channels/accountsTokens"
      },
      "messages": [
        {
          "$ref": "#/channels/accountsTokens/messages/AccountsTokensRequest"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/accountsTokens"
        },
        "messages": [
          {
            "$ref": "#/channels/accountsTokens/messages/AccountsTokensResponse"
          }
        ]
      },
      "bindings": {
        "http": {
          "method": "POST",
          "bindingVersion": "0.3.0"
        }
      },
      "tags": [
        {
          "name": "auth"
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "developerApiKey": {
        "type": "httpApiKey",
        "name": "developer-api-key",
        "in": "header",
        "description": "Your developer API key, sent as an HTTP header on the Socket.IO handshake. Browsers cannot\nset custom headers on a WebSocket handshake, so connect from a server, not from a web page.\nKeep the key out of source control, logs and chat messages.\n"
      }
    },
    "messages": {
      "ConnectionStatus": {
        "name": "ConnectionStatus",
        "title": "connection status",
        "payload": {
          "$ref": "#/components/schemas/ConnectionStatus"
        },
        "examples": [
          {
            "name": "connected",
            "payload": {
              "status": "ok",
              "code": "connected",
              "message": "Successfully connected to the streams socket server."
            }
          },
          {
            "name": "invalidApiKey",
            "summary": "The `developer-api-key` header is missing or appears more than once.",
            "payload": {
              "status": "error",
              "code": "unauthorized.streams.invalidApiKey",
              "message": "Invalid API key provided, make sure header 'developer-api-key' is valid."
            }
          },
          {
            "name": "developerNotFound",
            "summary": "The key is not a known developer key.",
            "payload": {
              "status": "error",
              "code": "unauthorized.streams.developer.notFound",
              "message": "Developer with the API key 'tl-abc***' not found."
            }
          },
          {
            "name": "conflict",
            "summary": "The developer key already has its maximum number of open sockets.",
            "payload": {
              "status": "error",
              "code": "conflict",
              "message": "Developer EXAMPLE has reached the maximum number of connections: 100 (max: 100)."
            }
          },
          {
            "name": "shutdown",
            "payload": {
              "status": "ok",
              "code": "disconnected",
              "message": "Disconnected from all accounts as the application is shutting down."
            }
          }
        ]
      },
      "Subscribe": {
        "name": "Subscribe",
        "title": "SUBSCRIBE",
        "payload": {
          "$ref": "#/components/schemas/SubscribeAction"
        },
        "examples": [
          {
            "name": "subscribe",
            "payload": {
              "action": "SUBSCRIBE",
              "token": "eyJhbGciOiJSUzI1NiJ9.eyJicmFuZCI6IkJBUElBIiwiYWlkIjoiTCM3MzcwMzEifQ.c2lnbmF0dXJl"
            }
          }
        ]
      },
      "Unsubscribe": {
        "name": "Unsubscribe",
        "title": "UNSUBSCRIBE",
        "payload": {
          "$ref": "#/components/schemas/UnsubscribeAction"
        },
        "examples": [
          {
            "name": "unsubscribe",
            "payload": {
              "action": "UNSUBSCRIBE",
              "brandId": "BAPIA",
              "accountId": "L#737031"
            }
          }
        ]
      },
      "SubscriptionAck": {
        "name": "SubscriptionAck",
        "title": "subscriptions acknowledgement",
        "payload": {
          "$ref": "#/components/schemas/SubscriptionAck"
        },
        "examples": [
          {
            "name": "subscribed",
            "payload": {
              "status": "ok",
              "code": "connected",
              "message": "Connected to account BAPIA#L#737031",
              "remainingRequests": 4999
            }
          },
          {
            "name": "unsubscribed",
            "payload": {
              "status": "ok",
              "code": "disconnected",
              "message": "Disconnected from account BAPIA#L#737031"
            }
          },
          {
            "name": "alreadyConnected",
            "payload": {
              "status": "error",
              "code": "alreadyConnectedError",
              "message": "Already connected to account BAPIA#L#737031"
            }
          },
          {
            "name": "noSuchConnection",
            "summary": "UNSUBSCRIBE for an account this socket does not have, for example a wrongly cased brand.",
            "payload": {
              "status": "error",
              "code": "noSuchConnectionError",
              "message": "No such connection for account Bapia#L#737031"
            }
          },
          {
            "name": "invalidJwt",
            "payload": {
              "status": "error",
              "code": "invalidJwt",
              "message": "Failed to decode token"
            }
          },
          {
            "name": "tooManyRequests",
            "payload": {
              "status": "error",
              "code": "tooManyRequests",
              "message": "Too many subscribe requests. Please wait. maxRequests=5000 windowMs=50 ms"
            }
          },
          {
            "name": "connectionError",
            "summary": "The account could not be connected (token exchange or trade-node logon failed). Retry with backoff.",
            "payload": {
              "status": "error",
              "code": "connectionError",
              "message": "unknown",
              "remainingRequests": 4998
            }
          },
          {
            "name": "validationError",
            "payload": {
              "status": "error",
              "code": "validationError - unrecognized_keys",
              "message": "Unrecognized key(s) in object: 'accountId'"
            }
          }
        ]
      },
      "AccountStatus": {
        "name": "AccountStatus",
        "title": "AccountStatus",
        "summary": "Balance, equity, margin and per-position PnL of one account.",
        "payload": {
          "$ref": "#/components/schemas/AccountStatus"
        },
        "examples": [
          {
            "name": "accountStatus",
            "payload": {
              "type": "AccountStatus",
              "currency": "USD",
              "balance": "9888.95",
              "balanceWithoutCredit": "9888.95",
              "equity": "10628.95",
              "marginAvailable": "3583.45",
              "marginUsed": "6305.5",
              "blockedBalance": "0",
              "credit": "0",
              "positionPnLs": [
                {
                  "positionId": "144115188076017329",
                  "pnl": "740"
                }
              ],
              "brandId": "BAPIA",
              "userId": "4f78705c-d09e-4fa8-9744-7a87d81b4327",
              "accountId": "L#706984"
            }
          }
        ]
      },
      "Position": {
        "name": "Position",
        "title": "Position",
        "summary": "An open position, sent in the snapshot and whenever it changes.",
        "payload": {
          "$ref": "#/components/schemas/Position"
        },
        "examples": [
          {
            "name": "position",
            "payload": {
              "type": "Position",
              "lots": "0.01",
              "lotSize": "10",
              "units": "0.1",
              "instrument": "ETHUSD",
              "openPrice": "3299.71",
              "openDateTime": "2026-03-19T20:15:51.465Z",
              "positionId": "144115188076017329",
              "openOrderId": "144115188076017328",
              "maintMargin": "3.06485",
              "side": "BUY",
              "brandId": "BAPIA",
              "userId": "4f78705c-d09e-4fa8-9744-7a87d81b4327",
              "accountId": "L#617509"
            }
          }
        ]
      },
      "ClosePosition": {
        "name": "ClosePosition",
        "title": "ClosePosition",
        "summary": "A position was closed.",
        "payload": {
          "$ref": "#/components/schemas/ClosePosition"
        },
        "examples": [
          {
            "name": "closePosition",
            "payload": {
              "type": "ClosePosition",
              "positionId": "144115188076313663",
              "closePrice": "0.62947",
              "closeDateTime": "2026-01-27T13:43:53.987Z",
              "brandId": "BAPIA",
              "userId": "4f78705c-d09e-4fa8-9744-7a87d81b4327",
              "accountId": "L#775077"
            }
          }
        ]
      },
      "OpenOrder": {
        "name": "OpenOrder",
        "title": "OpenOrder",
        "summary": "An order, sent in the snapshot and on every change, including fills and cancels.",
        "payload": {
          "$ref": "#/components/schemas/OpenOrder"
        },
        "examples": [
          {
            "name": "filledMarketOrder",
            "payload": {
              "type": "OpenOrder",
              "orderId": "144115188077153593",
              "instrument": "AUDUSD",
              "amount": "10",
              "lotSize": "100000",
              "side": "BUY",
              "price": "0.62956",
              "status": "STATUS_FILLED",
              "orderType": "MARKET",
              "tif": "IOC",
              "filledAmount": "10",
              "averageFilledPrice": "0.62962",
              "positionId": "144115188076313665",
              "isOpen": true,
              "createdDateTime": "2026-01-27T13:43:57.327Z",
              "lastUpdate": "2026-01-27T13:43:57.532Z",
              "brandId": "BAPIA",
              "userId": "4f78705c-d09e-4fa8-9744-7a87d81b4327",
              "accountId": "L#706984"
            }
          }
        ]
      },
      "Property": {
        "name": "Property",
        "title": "Property",
        "summary": "Stream lifecycle marker for one account (SyncEnd, Disconnected).",
        "payload": {
          "$ref": "#/components/schemas/Property"
        },
        "examples": [
          {
            "name": "syncEnd",
            "summary": "The snapshot for this account is complete; what follows is live.",
            "payload": {
              "type": "Property",
              "name": "SyncEnd",
              "brandId": "BAPIA",
              "userId": "4f78705c-d09e-4fa8-9744-7a87d81b4327",
              "accountId": "L#737031"
            }
          },
          {
            "name": "disconnected",
            "summary": "This account's stream ended (after an UNSUBSCRIBE, or on the server side).",
            "payload": {
              "type": "Property",
              "name": "Disconnected",
              "brandId": "BAPIA",
              "userId": "4f78705c-d09e-4fa8-9744-7a87d81b4327",
              "accountId": "L#737031"
            }
          }
        ]
      },
      "AccountsTokensRequest": {
        "name": "AccountsTokensRequest",
        "title": "Account tokens request",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/AccountsTokensRequest"
        },
        "examples": [
          {
            "name": "request",
            "payload": {
              "email": "trader@example.com",
              "password": "<password>",
              "server": "BAPIA"
            }
          }
        ]
      },
      "AccountsTokensResponse": {
        "name": "AccountsTokensResponse",
        "title": "Account tokens response",
        "contentType": "application/json",
        "payload": {
          "$ref": "#/components/schemas/AccountsTokensResponse"
        },
        "examples": [
          {
            "name": "response",
            "payload": {
              "data": [
                {
                  "accessToken": "eyJhbGciOiJSUzI1NiJ9.eyJicmFuZCI6IkJBUElBIiwiYWlkIjoiTCM3MzcwMzEifQ.c2lnbmF0dXJl",
                  "expireDate": "2026-10-16T10:28:32.000Z",
                  "accountId": "L#737031"
                }
              ]
            }
          }
        ]
      }
    },
    "schemas": {
      "Decimal": {
        "type": "string",
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
        "description": "Decimal number as a string, without exponent or trailing zeros. Parse with a decimal type.",
        "examples": [
          "10628.95"
        ]
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "ISO-8601 instant in UTC.",
        "examples": [
          "2026-01-27T13:43:57.532Z"
        ]
      },
      "BrandId": {
        "type": "string",
        "description": "Brand (the `server` the user logs in to), as in the token's `brand` claim. Matched exactly:\nreuse it as received.\n",
        "examples": [
          "BAPIA"
        ]
      },
      "AccountId": {
        "type": "string",
        "pattern": "^[LD]#[0-9]+$",
        "description": "Account, `L#` for live and `D#` for demo, as in the token's `aid` claim.",
        "examples": [
          "L#737031"
        ]
      },
      "UserId": {
        "type": "string",
        "description": "TradeLocker user ID (UUID).",
        "examples": [
          "4f78705c-d09e-4fa8-9744-7a87d81b4327"
        ]
      },
      "Id": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "Numeric identifier as a string. Do not parse it as a double; it exceeds 2^53.",
        "examples": [
          "144115188076017329"
        ]
      },
      "Side": {
        "type": "string",
        "enum": [
          "BUY",
          "SELL"
        ]
      },
      "ConnectionStatus": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "code": {
            "type": "string",
            "description": "Machine-readable result. Branch on `code`, never on `message`.",
            "enum": [
              "connected",
              "disconnected",
              "unauthorized.streams.invalidApiKey",
              "unauthorized.streams.developer.notFound",
              "conflict",
              "unknown"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable detail. Wording can change."
          }
        }
      },
      "SubscriptionAck": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "code": {
            "type": "string",
            "description": "- `connected`: subscribed. `SyncEnd` for the account has already been sent.\n- `disconnected`: unsubscribed.\n- `alreadyConnectedError`: already subscribed (or connecting) on this socket. Treat as subscribed.\n- `noSuchConnectionError`: UNSUBSCRIBE for an account this socket does not have. Check the exact `brandId` and `accountId`.\n- `invalidJwt`: token malformed, expired or not for this environment. Fetch a new token.\n- `tooManyRequests`: rate limit of the developer key. Wait and retry.\n- `connectionError`: the account could not be connected. Retry with backoff.\n- `clientNotFound`: the socket is closing or was rejected. Reconnect.\n- `validationError - <issue>`: malformed payload; `<issue>` is one of `invalid_type`, `invalid_union_discriminator`, `invalid_string`, `unrecognized_keys`.\n- `unknown`: unexpected server error. Retry with backoff.\n",
            "examples": [
              "connected",
              "alreadyConnectedError",
              "validationError - unrecognized_keys"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable detail. Wording can change."
          },
          "remainingRequests": {
            "type": "integer",
            "description": "SUBSCRIBE requests left in the developer key's rate-limit window."
          }
        }
      },
      "SubscribeAction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "token"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "SUBSCRIBE"
          },
          "token": {
            "type": "string",
            "description": "Account token (`accessToken`) from the account tokens endpoint."
          }
        }
      },
      "UnsubscribeAction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "brandId",
          "accountId"
        ],
        "properties": {
          "action": {
            "type": "string",
            "const": "UNSUBSCRIBE"
          },
          "brandId": {
            "$ref": "#/components/schemas/BrandId"
          },
          "accountId": {
            "$ref": "#/components/schemas/AccountId"
          }
        }
      },
      "AccountStatus": {
        "type": "object",
        "required": [
          "type",
          "currency",
          "balance",
          "balanceWithoutCredit",
          "marginAvailable",
          "marginUsed",
          "blockedBalance",
          "credit",
          "positionPnLs",
          "brandId",
          "userId",
          "accountId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "AccountStatus"
          },
          "currency": {
            "type": "string",
            "description": "Account currency.",
            "examples": [
              "USD"
            ]
          },
          "balance": {
            "$ref": "#/components/schemas/Decimal"
          },
          "balanceWithoutCredit": {
            "$ref": "#/components/schemas/Decimal"
          },
          "equity": {
            "$ref": "#/components/schemas/Decimal"
          },
          "marginAvailable": {
            "$ref": "#/components/schemas/Decimal"
          },
          "marginUsed": {
            "$ref": "#/components/schemas/Decimal"
          },
          "blockedBalance": {
            "$ref": "#/components/schemas/Decimal"
          },
          "credit": {
            "$ref": "#/components/schemas/Decimal"
          },
          "positionPnLs": {
            "type": "array",
            "description": "Gross PnL of each open position; empty when there are none.",
            "items": {
              "type": "object",
              "required": [
                "positionId",
                "pnl"
              ],
              "properties": {
                "positionId": {
                  "$ref": "#/components/schemas/Id"
                },
                "pnl": {
                  "$ref": "#/components/schemas/Decimal"
                }
              }
            }
          },
          "brandId": {
            "$ref": "#/components/schemas/BrandId"
          },
          "userId": {
            "$ref": "#/components/schemas/UserId"
          },
          "accountId": {
            "$ref": "#/components/schemas/AccountId"
          }
        }
      },
      "Position": {
        "type": "object",
        "required": [
          "type",
          "lots",
          "lotSize",
          "units",
          "instrument",
          "openPrice",
          "positionId",
          "openOrderId",
          "maintMargin",
          "side",
          "brandId",
          "userId",
          "accountId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "Position"
          },
          "lots": {
            "$ref": "#/components/schemas/Decimal"
          },
          "lotSize": {
            "$ref": "#/components/schemas/Decimal"
          },
          "units": {
            "$ref": "#/components/schemas/Decimal",
            "description": "`lots` multiplied by `lotSize`."
          },
          "instrument": {
            "type": "string",
