        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "accessToken",
                "expireDate",
                "accountId"
              ],
              "properties": {
                "accessToken": {
                  "type": "string",
                  "description": "Account token (JWT) for SUBSCRIBE. Claims include `brand` (brandId), `aid` (accountId),\n`host` (environment) and `exp`.\n"
                },
                "expireDate": {
                  "$ref": "#/components/schemas/Timestamp",
                  "description": "When the token expires. Subscribing needs a token that has not expired."
                },
                "accountId": {
                  "$ref": "#/components/schemas/AccountId"
                }
              }
            }
          }
        }
      }
